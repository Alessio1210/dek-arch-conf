// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "status_bar": {
    "active_language_button": false
  },
  "search": {
    "button": false
  },
  "global_lsp_settings": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "dock": "left"
  },
  "show_edit_predictions": true,
  "vim_mode": true,
  "mouse_wheel_zoom": true,
  "agent_ui_font_size": 11.0,
  "edit_predictions": {
    "provider": "zed"
  },
  "outline_panel": {
    "button": false,
    "dock": "left"
  },
  "agent": {
    "default_model": {
      "provider": "ollama",
      "model": "qwen3:14b",
      "enable_thinking": true
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "hard_tabs": true,
  "proxy": "",
  "project_panel": {
    "dock": "left"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 100
    }
  },
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "ssh_connections": [
    {
      "host": "192.168.2.101",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/alessio"
          ]
        }
      ]
    },
    {
      "host": "192.168.2.101",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/alessio/Project/mashine"
          ]
        }
      ]
    }
  ],
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono"
  },
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-luna"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 11.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "GitHub Dark",
  },
}
