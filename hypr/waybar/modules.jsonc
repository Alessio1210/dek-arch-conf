{
  "hyprland/workspaces": {
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {"1":"", "2":"", "3":"󰃹", "4":"󰂴", "5":"", "default":"", "active":"", "urgent":""},
    "sort-by-number": true,
    "persistent-workspaces": {"HDMI-A-1": [1,2,3,4,5,6], "eDP-1": [7,8,9,10,11,12]}
  },
  "hyprland/window": {"format":"{}", "max-length":70, "separate-outputs":true},
  "clock": {"format":"{:%a %d %b  %H:%M}", "tooltip":true, "tooltip-format":"<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"},
  "network": {"format-wifi":"  {signalStrength}%", "format-ethernet":"󰈀", "format-disconnected":"󰖪", "tooltip-format":"{ifname} via {gwaddr}", "on-click":"/home/alessio/.config/hypr/scripts/open-network-editor.sh", "on-click-right":"nm-connection-editor"},
  "cpu": {"format":"{usage}% ", "tooltip":false, "on-click":"bash /home/alessio/.config/arch-rice/waybar/scripts/btop.sh"},
  "memory": {"format":"{percentage}% "},
  "pulseaudio": {"format":"{icon} {volume}%", "format-muted":"󰍟", "format-icons":{"default":["","",""]}, "on-click":"pavucontrol"},
  "temperature": {"critical-threshold":80, "format":"{temperatureC}°C {icon}", "format-icons":["","",""]},
  "battery": {"states":{"warning":30,"critical":15}, "format":"{icon} {capacity}%", "format-charging":" {capacity}%", "format-plugged":" {capacity}%", "format-alt":"{time} {icon}", "format-icons":["","","","",""]},
  "tray": {"spacing":6},
  "custom/media": {"format":"{}", "escape":true, "return-type":"json", "max-length":40, "tooltip":true, "tooltip-format":"{}", "exec-if":"command -v playerctl >/dev/null 2>&1", "exec":"/home/alessio/.config/arch-rice/waybar/scripts/mediaplayer.py", "on-click":"playerctl play-pause", "on-click-right":"playerctl stop", "on-scroll-up":"playerctl next", "on-scroll-down":"playerctl previous"},
  "custom/swaync": {"format":"{icon}", "format-icons":{"notification":"","none":"","dnd-notification":"","dnd-none":""}, "return-type":"json", "exec-if":"command -v swaync-client >/dev/null 2>&1", "exec":"swaync-client -swb", "on-click":"sleep 0.1 && swaync-client -t -sw", "escape":true, "tooltip":false},
  "custom/lock_screen": {"format":"", "tooltip-format":"Lock screen", "on-click":"bash /home/alessio/.config/arch-rice/waybar/scripts/lock.sh"},
  "custom/change_user": {"format":"", "tooltip-format":"Logout / change user", "on-click":"bash /home/alessio/.config/arch-rice/waybar/scripts/change_user.sh"},
  "custom/suspend": {"format":"󰒄", "tooltip-format":"Suspend", "on-click":"bash /home/alessio/.config/arch-rice/waybar/scripts/suspend.sh"},
  "custom/shutdown": {"format":"", "tooltip-format":"Shutdown", "on-click":"bash /home/alessio/.config/arch-rice/waybar/scripts/shutdown.sh"}
}
